<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>リトモス ボット コントローラー</title>
    <link rel="stylesheet" href="/public/style.css">
</head>
<body>
    <div class="floating-circles">
        <div class="floating-circle"></div>
        <div class="floating-circle"></div>
        <div class="floating-circle"></div>
        <div class="floating-circle"></div>
        <div class="floating-circle"></div>
        <div class="floating-circle"></div>
    </div>
    <div class="container">
        <header>
            <h1>🤖 リトモス予約ボット コントローラー</h1>
        </header>
        <main>
            <div class="dashboard">
                <div class="password-section">
                    <h2>パスワード変更</h2>
                    <form id="passwordForm" class="password-form">
                        <div class="form-group">
                            <label>現在のパスワード:</label>
                            <input type="password" id="currentPassword" name="currentPassword" required>
                        </div>
                        <div class="form-group">
                            <label>新しいパスワード:</label>
                            <input type="password" id="newPassword" name="newPassword" required>
                        </div>
                        <button type="submit" class="btn btn-secondary">パスワードを更新</button>
                    </form>
                </div>

                <div class="profiles-section">
                    <div class="profiles-header">
                        <h2>プロフィール</h2>
                        <div style="display: flex; gap: 12px;">
                            <button id="addProfileBtn" class="btn btn-primary">+ プロフィールを追加</button>
                            <button id="runSelectedBtn" class="btn btn-success">▶ 選択したボットを実行</button>
                            <!-- <button id="runAllBtn" class="btn btn-success">▶ すべてのボットを実行</button> -->
                        </div>
                    </div>
                    
                    <% if (profiles && profiles.length > 0) { %>
                        <table class="profiles-table">
                            <thead>
                                <tr>
                                    <th style="width: 40px;">
                                        <input type="checkbox" id="selectAllCheckbox" onchange="toggleSelectAll()">
                                    </th>
                                    <th>プロフィール名</th>
                                    <th>ステータス</th>
                                    <th>操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% profiles.forEach((profile, index) => { %>
                                    <tr data-profile="<%= profile.name %>">
                                        <td class="profile-checkbox-cell">
                                            <input type="checkbox" class="profile-checkbox" value="<%= profile.name %>" onchange="updateRunButtonState()">
                                        </td>
                                        <td class="profile-name-cell"><%= profile.name %></td>
                                        <td class="profile-status-cell">
                                            <span class="profile-status-badge status-<%= profile.status.status || 'inactive' %>">
                                                <% if (profile.status.status === 'running') { %>
                                                    🟢 実行中
                                                <% } else if (profile.status.status === 'success') { %>
                                                    ✅ 成功
                                                <% } else if (profile.status.status === 'failure') { %>
                                                    ❌ 失敗
                                                <% } else { %>
                                                    ⚪ 無効
                                                <% } %>
                                            </span>
                                        </td>
                                        <td class="profile-actions-cell">
                                            <button class="profile-expand-btn" onclick="toggleProfileDetails('<%= profile.name %>')" data-profile="<%= profile.name %>">
                                                <span class="expand-icon">▼</span>
                                                <span>詳細</span>
                                            </button>
                                        </td>
                                    </tr>
                                    <tr class="profile-details-row" id="details-<%= profile.name %>" data-profile="<%= profile.name %>">
                                        <td colspan="4" class="profile-details-cell">
                                            <div class="profile-details-content">
                                                <div class="profile-status-info">
                                                    <% if (profile.status.status === 'running') { %>
                                                        <p><strong>ステータス:</strong> <%= profile.status.timestamp ? new Date(profile.status.timestamp).toLocaleString('ja-JP') : 'N/A' %> から実行中</p>
                                                    <% } else if (profile.status.status === 'success') { %>
                                                        <p><strong>ステータス:</strong> 成功</p>
                                                        <p><strong>完了:</strong> <%= profile.status.timestamp ? new Date(profile.status.timestamp).toLocaleString('ja-JP') : 'N/A' %></p>
                                                    <% } else if (profile.status.status === 'failure') { %>
                                                        <p><strong>ステータス:</strong> 失敗</p>
                                                        <p><strong>失敗:</strong> <%= profile.status.timestamp ? new Date(profile.status.timestamp).toLocaleString('ja-JP') : 'N/A' %></p>
                                                        <% if (profile.status.message) { %>
                                                            <p><strong>エラー:</strong> <span class="error-text"><%= profile.status.message %></span></p>
                                                        <% } %>
                                                    <% } else { %>
                                                        <p><strong>ステータス:</strong> 無効</p>
                                                    <% } %>
                                                </div>
                                                
                                                <form class="profile-form" data-profile="<%= profile.name %>">
                                                    <div class="form-group">
                                                        <label>ログインID:</label>
                                                        <input type="text" name="login.id" value="<%= profile.config.login.id %>" required>
                                                    </div>
                                                    <div class="form-group">
                                                        <label>パスワード:</label>
                                                        <input type="text" name="login.password" value="<%= profile.config.login.password %>" required>
                                                    </div>
                                                    <div class="form-group">
                                                        <label>予約時間: (例: 2025/03/05 08:00)</label>
                                                        <input type="text" name="reservation.time" value="<%= profile.config.reservation.time %>" pattern="\d{4}/\d{2}/\d{2} \d{2}:\d{2}" placeholder="2025/11/21 23:32" required>
                                                    </div>
                                                    <div class="form-group">
                                                        <label>フライング時間（秒）:</label>
                                                        <input type="number" name="reservation.flying_time" value="<%= profile.config.reservation.flying_time %>" step="0.01" required>
                                                    </div>
                                                    <div class="form-group">
                                                        <label>予約を確認:</label>
                                                        <input type="checkbox" name="reservation.confirm_reservation" <%= profile.config.reservation.confirm_reservation ? 'checked' : '' %>>
                                                    </div>
                                                    <div class="form-group">
                                                        <label>店舗インデックス:</label>
                                                        <input type="number" name="store.selected_store_index" value="<%= profile.config.store.selected_store_index %>" required>
                                                    </div>
                                                <div class="form-group">
                                                    <label>レッスン日付セレクター:</label>
                                                    <div class="selector-input-group">
                                                        <div class="selector-numbers">
                                                            <label class="selector-number-label">日付行:</label>
                                                            <input type="number" class="selector-number-input" 
                                                                   name="lesson.date_selector.row"
                                                                   data-selector-type="date" 
                                                                   data-selector-index="0" 
                                                                   data-profile="<%= profile.name %>"
                                                                   value="<%= profile.config.lesson.date_selector.row || 3 %>" 
                                                                   min="1" required>
                                                            <label class="selector-number-label">日付列:</label>
                                                            <input type="number" class="selector-number-input" 
                                                                    name="lesson.date_selector.col"
                                                                    data-selector-type="date" 
                                                                    data-selector-index="1" 
                                                                    data-profile="<%= profile.name %>"
                                                                    value="<%= profile.config.lesson.date_selector.col || 15 %>" 
                                                                    min="1" required>
                                                        </div>
                                                        <input type="text" class="selector-string-display" 
                                                            name="lesson.date_selector.selector"
                                                               data-selector-type="date"
                                                               data-profile="<%= profile.name %>"
                                                               value="<%= profile.config.lesson.date_selector.selector %>" 
                                                               readonly>
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <label>レッスン場所セレクター:</label>
                                                    <div class="selector-input-group">
                                                        <div class="selector-numbers">
                                                            <label class="selector-number-label">行インデックス:</label>
                                                            <input type="number" class="selector-number-input" 
                                                                   name="lesson.location_selector.row" 
                                                                   data-selector-type="location" 
                                                                   data-selector-index="0"
                                                                   data-profile="<%= profile.name %>"
                                                                   value="<%= profile.config.lesson.location_selector.row || 3 %>" 
                                                                   min="1" required>
                                                            <label class="selector-number-label">列インデックス:</label>
                                                            <input type="number" class="selector-number-input" 
                                                                   name="lesson.location_selector.col" 
                                                                   data-selector-type="location" 
                                                                   data-selector-index="1"
                                                                   data-profile="<%= profile.name %>"
                                                                   value="<%= profile.config.lesson.location_selector.col || 6 %>" 
                                                                   min="1" required>
                                                        </div>
                                                        <input type="text" class="selector-string-display" 
                                                                name="lesson.location_selector.selector"
                                                               data-selector-type="location"
                                                               data-profile="<%= profile.name %>"
                                                               value="<%= profile.config.lesson.location_selector.selector %>" 
                                                               readonly>
                                                    </div>
                                                </div>
                                                    <div class="form-actions">
                                                        <button type="submit" class="btn btn-primary">プロフィールを保存</button>
                                                        <button type="button" class="btn btn-danger" onclick="deleteProfile('<%= profile.name %>')">プロフィールを削除</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    <% } else { %>
                        <div class="no-profiles">
                            <p>プロフィールが見つかりません。「プロフィールを追加」をクリックして作成してください。</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </main>
        <footer>
            <p>&copy; 2025 リトモス ボット コントローラー</p>
        </footer>
    </div>

    <!-- Add Profile Modal -->
    <div id="addProfileModal" class="modal" style="display: none;">
        <div class="modal-content">
            <div class="modal-header">
                <h2>新しいプロフィールを追加</h2>
                <button class="modal-close" onclick="closeAddProfileModal()">×</button>
            </div>
            <div class="modal-body">
                <form id="addProfileForm">
                    <div class="form-group">
                        <label>プロフィール名:</label>
                        <input type="text" id="newProfileName" name="profileName" required pattern="[a-zA-Z0-9_-]+" title="英数字、アンダースコア、ハイフンのみ使用可能">
                        <small>プロフィール名は設定ファイル名として使用されます（例: hiromi.json）</small>
                    </div>
                    <div class="form-group">
                        <label>ログインID:</label>
                        <input type="text" name="login.id" required>
                    </div>
                    <div class="form-group">
                        <label>パスワード:</label>
                        <input type="text" name="login.password" required>
                    </div>
                    <div class="form-group">
                        <label>予約時間:</label>
                        <input type="text" name="reservation.time" pattern="\d{4}/\d{2}/\d{2} \d{2}:\d{2}" placeholder="2025/11/21 23:32" required>
                    </div>
                    <div class="form-group">
                        <label>フライング時間（秒）:</label>
                        <input type="number" name="reservation.flying_time" step="0.01" required>
                    </div>
                    <div class="form-group">
                        <label>予約を確認:</label>
                        <input type="checkbox" name="reservation.confirm_reservation">
                    </div>
                    <div class="form-group">
                        <label>店舗インデックス:</label>
                        <input type="number" name="store.selected_store_index" required>
                    </div>
                    <div class="form-group">
                        <label>レッスン日付セレクター:</label>
                        <div class="selector-input-group">
                            <div class="selector-numbers">
                                <label class="selector-number-label">行インデックス:</label>
                                <input type="number" class="selector-number-input" 
                                       name="lesson.date_selector.row" 
                                       data-selector-type="date" 
                                       data-selector-index="0"
                                       data-profile="new"
                                       value="3" 
                                       min="1" required>
                                <label class="selector-number-label">列インデックス:</label>
                                <input type="number" class="selector-number-input" 
                                       name="lesson.date_selector.col" 
                                       data-selector-type="date" 
                                       data-selector-index="1"
                                       data-profile="new"
                                       value="15" 
                                       min="1" required>
                            </div>
                            <input type="text" class="selector-string-display" 
                                   name="lesson.date_selector.selector" 
                                   data-selector-type="date"
                                   data-profile="new"
                                   value="#listcontainer3 > td:nth-child(15) > a > p.lesson_name" 
                                   readonly>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>レッスン場所セレクター:</label>
                        <div class="selector-input-group">
                            <div class="selector-numbers">
                                <label class="selector-number-label">行インデックス:</label>
                                <input type="number" class="selector-number-input" 
                                       name="lesson.location_selector.row" 
                                       data-selector-type="location" 
                                       data-selector-index="0"
                                       data-profile="new"
                                       value="3" 
                                       min="1" required>
                                <label class="selector-number-label">列インデックス:</label>
                                <input type="number" class="selector-number-input" 
                                       name="lesson.location_selector.col" 
                                       data-selector-type="location" 
                                       data-selector-index="1"
                                       data-profile="new"
                                       value="6" 
                                       min="1" required>
                            </div>
                            <input type="text" class="selector-string-display" 
                                   name="lesson.location_selector.selector" 
                                   data-selector-type="location"
                                   data-profile="new"
                                   value="#main > div.overflow-wrap > div > fieldset > fieldset > div > table > tbody > tr:nth-child(3) > td:nth-child(6) > div > label" 
                                   readonly>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">プロフィールを作成</button>
                        <button type="button" class="btn btn-secondary" onclick="closeAddProfileModal()">キャンセル</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="/public/app.js"></script>
</body>
</html>
