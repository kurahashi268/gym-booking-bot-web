# Bot Directory Path (relative to web directory or absolute path)
# Example: ../new-version or /absolute/path/to/new-version
BOT_DIR=../new-version

# Config File Path (relative or absolute path)
# If not set, will default to BOT_DIR/config.json
# Example: ../new-version/config.json or /absolute/path/to/config.json
CONFIG_PATH=

# Auth File Path (relative to web directory or absolute path)
# Example: ./auth.json or /absolute/path/to/auth.json
AUTH_PATH=./auth.json
